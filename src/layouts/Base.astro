---
import { u } from '../lib/url';
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  article?: { published: string; modified?: string };
  hideSubtitle?: boolean;
}
const { title, description = SITE.description, noindex = false, ogImage = '/ogp-20261017.png', article, hideSubtitle = false } = Astro.props;
// 公開日まで検索よけ（PUBLIC_NOINDEX=0 で外す）
const globalNoindex = (import.meta.env.PUBLIC_NOINDEX ?? '1') !== '0';
const ogImageUrl = new URL(u(ogImage), Astro.site).toString();
const siteName = SITE.name;
const homeUrl = new URL(u('/'), Astro.site).toString();
const operatorLd = {
  '@type': 'Person', name: SITE.operator, url: new URL(u('/about/'), Astro.site).toString(),
  sameAs: [SITE.instagramUrl, SITE.facebookUrl, SITE.lineUrl].filter(Boolean),
};
const isHome = Astro.url.pathname === u('/');
const ld: any[] = [];
if (isHome) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'WebSite', name: siteName,
    url: homeUrl, inLanguage: 'ja', description, publisher: operatorLd,
  });
}
if (article) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'Article',
    headline: title, description, datePublished: article.published, dateModified: article.modified ?? article.published,
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    author: operatorLd, publisher: operatorLd, image: [ogImageUrl], inLanguage: 'ja',
  });
}
if (!isHome) {
  const parts = Astro.url.pathname.replace(u('/'), '/').split('/').filter(Boolean);
  const names: Record<string, string> = { gian: '議案の深掘り', mame: '議会の豆知識' };
  const items = [{ name: siteName, url: homeUrl }];
  let acc = '/';
  parts.forEach((p, i) => {
    acc += p + '/';
    const last = i === parts.length - 1;
    items.push({ name: last ? (title ?? p) : (names[p] ?? p), url: new URL(u(acc), Astro.site).toString() });
  });
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: items.map((it, i) => ({ '@type': 'ListItem', position: i + 1, name: it.name, item: it.url })),
  });
}
const fullTitle = title
  ? `${title}｜${SITE.name}`
  : `${SITE.name}（鳥取県大山町）｜署名から議会までの流れと提案の中身`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {(noindex || globalNoindex) && <meta name="robots" content="noindex" />}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={SITE.name} />
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={u('/favicon-48.png')} type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@700;800&family=Zen+Kaku+Gothic+New:wght@500;700&family=Klee+One:wght@600&display=swap" rel="stylesheet" />
  {ld.map((jsonld) => <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />)}
  <script is:inline>
    try { if (localStorage.getItem('dm.big') === '1') document.documentElement.classList.add('big'); } catch (e) {}
  </script>
  <!-- アクセス解析（Googleアナリティクス GA4） -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3EM00GE2LG"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-3EM00GE2LG');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="head-row">
      {isHome ? (
        <h1 class="logo-h1"><a class="logo" href={u('/')}>
          <span class="logo-place">{SITE.place}</span>
          <span class="logo-row"><span class="logo-main kari">{SITE.name}</span></span>
        </a></h1>
      ) : (
        <a class="logo" href={u('/')} aria-label={`${SITE.name}（トップページへ）`}>
          <span class="logo-place">{SITE.place}</span>
          <span class="logo-row"><span class="logo-main kari">{SITE.name}</span></span>
        </a>
      )}
      <div class="head-btns">
        <button type="button" class="hbtn js-big" data-off="大きく" data-on="標準に" aria-label="文字を大きくする"><span class="ic" aria-hidden="true">文字</span><span class="lb">大きく</span></button>
        <button type="button" class="hbtn" id="menuBtn" aria-expanded="false" aria-controls="menu"><span class="ic" aria-hidden="true">≡</span><span class="lb">メニュー</span></button>
      </div>
    </div>
    <div class="futasuji"></div>
    {!hideSubtitle && <p class="fukudai">{SITE.subtitle.split('、').map((part, i, arr) => <span class="nw">{part}{i < arr.length - 1 ? '、' : ''}</span>)}</p>}
  </header>
  <nav class="menu" id="menu" aria-label="メニュー">
    <ul>
      <li><button type="button" class="js-big">文字を大きくする</button></li>
      <li><a href={u('/#nagare')}>署名から議会までの流れ</a></li>
      <li><a href={u('/seikyu/')}>署名していただく内容</a></li>
      <li><a href={u('/teisu/')}>提案の中身（議員定数の記事）</a></li>
      <li><a href={u('/ai-interview/')}>AIインタビュー</a></li>
      <li><a href={u('/about/')}>請求代表者について</a></li>
      <li><a href={u('/line/')}>お知らせを受け取る</a></li>
      <li><a href={u('/contact/')}>お問い合わせ</a></li>
    </ul>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="futasuji"></div>
    <div class="inner">
      <nav aria-label="フッター">
        <a href={u('/about/')}>請求代表者について</a>｜<a href={u('/contact/')}>お問い合わせ</a>｜<a href={u('/line/')}>お知らせを受け取る</a>
      </nav>
      <p class="copy" style="font-size:12px">このサイトは、閲覧の状況を知るためにGoogleアナリティクスを使っています。個人を特定する情報は集めていません。</p>
      <p class="copy">© 2026 {SITE.name}</p>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btn = document.getElementById('menuBtn');
      var menu = document.getElementById('menu');
      btn.addEventListener('click', function () {
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      function label() {
        var on = document.documentElement.classList.contains('big');
        document.querySelectorAll('.js-big').forEach(function (b) {
          if (b.dataset.off) {
            b.querySelector('.lb').textContent = on ? b.dataset.on : b.dataset.off;
            b.setAttribute('aria-label', on ? '文字を標準にする' : '文字を大きくする');
          } else {
            b.textContent = on ? '文字を標準にする' : '文字を大きくする';
          }
        });
      }
      document.querySelectorAll('.js-big').forEach(function (b) {
        b.addEventListener('click', function () {
          var on = document.documentElement.classList.toggle('big');
          try { localStorage.setItem('dm.big', on ? '1' : '0'); } catch (e) {}
          label();
        });
      });
      label();
      document.querySelectorAll('.js-allopen').forEach(function (b) {
        b.addEventListener('click', function () {
          var ds = document.querySelectorAll('details.fold');
          var anyClosed = Array.prototype.some.call(ds, function (d) { return !d.open; });
          ds.forEach(function (d) { d.open = anyClosed; });
          b.textContent = anyClosed ? 'すべて閉じる' : 'すべて開く';
        });
      });
    })();
  </script>
</body>
</html>
