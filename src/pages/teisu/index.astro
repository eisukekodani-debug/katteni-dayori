---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import HBar from '../../components/HBar.astro';
import Flow from '../../components/Flow.astro';

const kennai = [
  ['湯梨浜町', '15,983', '77.9', '12', '2025年 13人／12', '―（2013年から12人）'],
  ['琴浦町', '15,236', '140.0', '16', '2026年 20人／16', '―'],
  ['八頭町', '15,092', '206.7', '14', '2025年 無投票', '2016年 16→14'],
  ['大山町', '14,313', '189.8', '16', '2025年 17人／16', '2012年 19→16'],
  ['北栄町', '13,820', '56.9', '13', '2025年 無投票', '2024年 15→13'],
  ['岩美町', '10,415', '122.3', '12', '2026年 13人／12', '―（2006年から12人）'],
  ['伯耆町', '10,063', '139.4', '13', '2025年 無投票', '2024年 14→13'],
  ['南部町', '9,781', '114.0', '14', '2024年 無投票', '―'],
  ['智頭町', '5,822', '224.7', '10', '2025年 11人／10', '2023年 12→10'],
  ['三朝町', '5,533', '233.5', '10', '2025年 12人／10', '2024年 12→10'],
  ['日南町', '3,673', '341.0', '10', '2023年 無投票', '2017年 12→10'],
  ['日吉津村', '3,575', '4.2', '10', '2023年 無投票', '―'],
  ['若桜町', '2,542', '199.2', '8', '2026年 11人／8', '2023年 10→8'],
  ['日野町', '2,511', '134.0', '10', '2023年 11人／10', '―'],
  ['江府町', '2,394', '124.5', '9', '2025年 10人／9', '2025年 10→9'],
];
---
<Base
  title="大山町の議員定数を減らしたい！"
  ogImage="/ogp-20261017.png"
  article={{ published: '2026-10-13T09:00:00+09:00' }}
  description="鳥取県大山町議会の議員定数（いまは16人）について、16人を維持する・減らす、の2つの考え方を整理しました。議員定数を14人にする直接請求の手続きも解説します。"
>
  <article class="wrap">
    <p class="go">2026年10月13日（火）</p>
    <div class="futasuji"></div>
    <h1 class="title">大山町の議員定数を減らしたい！</h1>
    <p class="deck">維持するか、減らすか――2つの考え方</p>
    <p class="byline">
      <span>文・{SITE.operator}｜公開 10月13日（火）</span>
      <button type="button" class="tbtn js-big" style="min-height:40px">文字を大きくする</button>
    </p>


    <section class="card" aria-label="1分でわかる">
      <div class="futasuji"></div>
      <span class="fuda">1分でわかる</span>
      <p class="state"><b>署名集めの期間中（10月17日〜11月16日）</b></p>
      <ul class="sum">
        <li><span>いまの段階</span>まだ議案ではありません。署名が有権者の50分の1以上（248人以上）集まると、町長が議会に条例案を出し、そこで初めて議案になります</li>
        <li><span>何が起きる</span>議員の数を16人から14人にする案を、町民の署名で町に求める手続きが始まりました（10月16日に告示、17日から署名集め）</li>
        <li><span>いつから</span>変わるのは次の町議選（2029年4月）から。いまの議員の任期には影響しません</li>
        <li><span>決めるのは</span>署名が集まったあと、町議会が賛否を決めます</li>
      </ul>
      <a class="pbtn" href={u('/#nagare')}>署名から議会までの流れを見る</a>
      <p class="yakusoku">このサイトでは署名を集めていません。署名は、正式な署名簿に、ご本人が自筆でお願いします。</p>
    </section>

    <section class="dekiru" aria-label="あなたにできること">
      <h2>あなたにできること</h2>
      <ol>
        <li><details><summary><b>読む</b></summary><div class="dk">このページで、2つの考え方と主な論点を確かめられます。</div></details></li>
        <li><details><summary><b>署名のことを知る</b></summary><div class="dk">14人にすることに賛成の方は、署名で意思を示せます。署名を集める期間は10月17日（土）〜11月16日（月）で、正式な署名簿にご本人が自筆で書きます。何に署名するのかは<a href={u('/seikyu/')}>「署名していただく内容」</a>に全文を載せています。このサイトでは署名を集めていません。こちらからうかがう方法と会場で署名する方法は、<a href={u('/#shomei')}>「署名のしかた」</a>をご覧ください。</div></details></li>
        <li><details><summary><b>お知らせを受け取る</b></summary><div class="dk">署名の受付会場や、議会の結果をLINEでお届けします。<a class="sbtn" href={SITE.lineUrl}>LINEで友だち追加する</a></div></details></li>
      </ol>
    </section>

    <p class="allopen"><button type="button" class="js-allopen">すべて開く</button></p>

    <details class="fold" open>
      <summary>一言で言うと</summary>
      <div class="body">
        <p>大山町議会の議員の数（定数）は、2013年の町議選から16人のままです。その間に町の人口は約2割減りました。この定数を14人に変える条例の改正を、町民が署名を集めて町に求める「直接請求」が、2026年10月に始まりました。署名を集める期間は10月17日〜11月16日です。</p>
        <p>議員の数に「これが正解」という決まった答えはありません。16人のままがいいという考えにも、減らすべきだという考えにも、それぞれの理由があります。この記事では、それぞれの理由を並べます。</p>
        <figure class="chart">
          <figcaption class="chart-title">大山町議会の定数は、2013年から16人のまま</figcaption>
          <div class="timeline4">
            <div><p class="y">2005年<br />合併</p><p class="n">21<small>人</small></p></div>
            <div><p class="y">2009年<br />町議選から</p><p class="n">19<small>人</small></p></div>
            <div><p class="y">2013年<br />町議選から</p><p class="n">16<small>人</small></p></div>
            <div><p class="y">2026年<br />いまも</p><p class="n">16<small>人</small></p></div>
          </div>
          <p class="chart-note">出典：大山町議会議員の定数を定める条例と附則（2008年・2012年の改正）</p>
        </figure>
        <figure class="chart">
          <figcaption class="chart-title">その間に、人口は約2割減った</figcaption>
          <div class="cols4">
            <div class="c"><span class="v">17,818人</span><span class="bar" style="height:120px"></span></div>
            <div class="c"><span class="v">16,889人</span><span class="bar" style="height:114px"></span></div>
            <div class="c"><span class="v">15,822人</span><span class="bar" style="height:107px"></span></div>
            <div class="c hi"><span class="v">14,313人</span><span class="bar" style="height:96px"></span></div>
            <span class="l">2012年<br />3月末<br />（16人に<br />決めた頃）</span>
            <span class="l">2016年<br />3月末</span>
            <span class="l">2021年<br />3月末</span>
            <span class="l">2026年<br />10月1日<br />（いま）</span>
          </div>
          <p class="chart-note">2012〜2021年は住民基本台帳の人口（大山町「大山町人口動向分析及び将来人口推計」）。2026年は大山町ホームページの人口。国立社会保障・人口問題研究所の推計（2023年推計）では、次の町議選がある2029年には約1万3千人、2033年には約1万2千人になる見込みです。</p>
        </figure>
        <h3 id="hikaku">県内・全国の町と比べると</h3>
        <p>県内の町村で、定数16人は大山町と琴浦町だけです。この10年ほどで、8つの町が定数を見直しました（若桜・智頭・八頭・三朝・北栄・伯耆・日南・江府）。</p>
        <HBar
          title="鳥取県内の町村の定数（人口の多い順）"
          unit="人"
          items={kennai.map((r) => ({ label: r[0], value: Number(r[3]), hi: r[3] === '16', sub: `${r[1]}人` }))}
          note="人口は住民基本台帳（2026年4〜5月現在。大山町と岩美町は10月1日現在）。定数は各町村の議員定数条例。網かけは定数16人の町。"
        />
        <HBar
          title="全国の、人口が同じくらいの町の定数"
          caption="人口1.3万〜1.5万人の町は全国に61町。定数16人は、大山町を含めて9町です。"
          unit="町"
          items={[
            { label: '10人', value: 4 },
            { label: '11人', value: 4 },
            { label: '12人', value: 11 },
            { label: '13人', value: 8 },
            { label: '14人', value: 22 },
            { label: '15人', value: 3 },
            { label: '16人', value: 9, hi: true, sub: '大山町はここ' },
          ]}
          note="住民基本台帳人口13,000人以上15,000人未満の町（村は除く）。人口は調査時点の値で、大山町は14,599人（2026年10月1日現在は14,313人）。"
        />
        <HBar
          title="全国の、面積が同じくらいの町の定数"
          caption="面積180〜220km²の町は全国に45町。真ん中の値は12人で、定数10人の町がいちばん多い（15町）。16人は大山町と香川県まんのう町の2町だけです。"
          unit="町"
          items={[
            { label: '8人', value: 1 },
            { label: '9人', value: 3 },
            { label: '10人', value: 15 },
            { label: '11人', value: 2 },
            { label: '12人', value: 11 },
            { label: '13人', value: 4 },
            { label: '14人', value: 6 },
            { label: '15人', value: 1 },
            { label: '16人', value: 2, hi: true, sub: '大山町はここ' },
          ]}
          note="面積180km²以上220km²未満の町（村は除く）。大山町は189.7km²。面積だけで区切ると、人口の少ない町も含まれます。"
        />
        <p class="note">全国の2つのグラフは、全国町村議会議長会「第71回町村議会実態調査」の町村別データ（2025年7月1日現在）から集計しました。定数は調査時点の値で、その後に見直した町もあります。</p>
        <div class="hscroll">
          <table class="data wide">
            <thead><tr><th>町村</th><th>人口</th><th>面積km²</th><th>定数</th><th>直近の選挙（立候補／定数）</th><th>定数の見直し</th></tr></thead>
            <tbody>
              {kennai.map((r) => (
                <tr><th>{r[0]}</th><td class="n">{r[1]}</td><td class="n">{r[2]}</td><td class="n">{r[3]}</td><td>{r[4]}</td><td>{r[5]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">人口は各町村が公表する住民基本台帳人口（2026年4〜5月現在。大山町と岩美町は10月1日現在）、人口の多い順。面積は国土地理院。選挙は選挙ドットコムと各町村の選挙結果、見直しは各町村の議員定数条例の附則で確認。見直しは議決の年で、適用は次の一般選挙から。大山町の現員は15人（欠員1）。</p>
        <h3>数字で見る、いまの大山町議会</h3>
        <table class="data">
          <tbody>
            <tr><th>議員の数</th><td>定数16人（いまは15人。2026年1月に1人が辞職）</td></tr>
            <tr><th>常任委員会</th><td>2つ（総務経済、教育民生）。定数16人なら8人ずつ</td></tr>
            <tr><th>前回の町議選</th><td>2025年4月。定数16に17人が立候補し、落選は1人。投票率70.5%</td></tr>
            <tr><th>議員報酬</th><td>月額23万5千円。期末手当とあわせて、1人あたり年約380万円</td></tr>
          </tbody>
        </table>
        <p class="note">出典：大山町議会議員の定数を定める条例と附則、国勢調査、大山町の住民基本台帳人口、大山町議会「議会の構成」、選挙ドットコム、大山町議会議員の議員報酬及び費用弁償等に関する条例。</p>
      </div>
    </details>

    <details class="fold">
      <summary>直接請求って何？どう進む？</summary>
      <div class="body">
        <p>直接請求は、地方自治法第74条にもとづく町民の権利です。有権者の50分の1以上の署名を集めると、条例の案そのものを、町議会の正式な議題にできます。お願いの文書を出す「陳情」とは違い、町は20日以内に議会を開き、条例案を議会に出さなければなりません。</p>
        <p>大山町議会基本条例の第17条も、議員定数の改正に当たっては町民の多様な意見を考慮しなければならないとし（第2項）、町民の直接請求による改正案があることを前提としています（第3項）。</p>
        <Flow
          title="直接請求の流れ（審査から先の日付は予定）"
          steps={[
            { t: '申請と告示', when: '10月13日に申請、16日に告示', d: '請求の代表者が町に申請し、町が証明書を交付して告示します。' },
            { t: '署名集め（1か月）', when: '10月17日〜11月16日', d: '有権者の50分の1以上（248人以上）。ご本人が、正式な署名簿に自筆で書きます。' },
            { t: '審査と縦覧', when: '11月下旬〜12月中旬', d: '署名簿を11月24日までに提出します。選挙管理委員会が20日以内に署名を審査し、署名簿を7日間、誰でも見られるようにします（縦覧）。' },
            { t: '町へ請求', when: '12月下旬ごろ', d: '町は請求の要旨を公表し、20日以内に議会を開いて、意見を付けて条例案を出します。' },
            { t: '議会で審議', when: '1月ごろ', d: '請求の代表者が、議会で意見を述べることができます（法律で保障されています）。' },
            { t: '議会が決める', d: '可決・否決・修正ができます。結果は公表されます。' },
          ]}
          note="出典：地方自治法第74条・第74条の2、同法施行令第91〜92条。有権者数は2026年9月1日の選挙人名簿（12,359人）から計算。"
        />
        <figure class="chart">
          <figcaption class="chart-title">陳情との違い</figcaption>
          <table class="cmp">
            <thead><tr><th></th><th>陳情</th><th>直接請求</th></tr></thead>
            <tbody>
              <tr><th>議会に出るもの</th><td>要望の文書</td><td class="em">条例案そのもの</td></tr>
              <tr><th>町</th><td>原則関わらない</td><td class="em">20日以内に議会を開く</td></tr>
              <tr><th>町民の発言</th><td>保障はない</td><td class="em">代表者が議会で意見を述べられる</td></tr>
              <tr><th>署名</th><td>決まった手続きはない</td><td class="em">選挙管理委員会が審査・縦覧</td></tr>
            </tbody>
          </table>
        </figure>
        <p>署名に必要な数は、有権者の50分の1以上です。2026年9月1日の選挙人名簿（12,359人）で計算すると248人以上。正式な数は、選挙管理委員会が告示のときに示します。</p>
        <p class="note">署名は、正式な署名簿に、ご本人が自筆で書くものだけが有効です。このサイトでは署名を集めていません。出典：地方自治法第74条・第74条の2、同法施行令第91〜92条、大山町議会基本条例。日付は予定です。</p>
      </div>
    </details>

    <details class="fold">
      <summary>2つの考え方</summary>
      <div class="body">
        <p>並べる順番は、どちらが正しいかを示す順ではありません。</p>
        <div class="stances two">
          <section class="stance">
            <h3>16人を維持する<span>という意見</span></h3>
            <ul>
              <li><b class="pt">声を幅広く届ける</b>町民の声を幅広く反映するには、今の人数が必要だ。</li>
              <li><b class="pt">広い町だから</b>大山町は189.8km²と広く、2005年に3つの町が合併してできた。人口が同じくらいの全国の町どうしで比べると、面積の広い町ほど、議員がやや多い傾向がある。</li>
              <li><b class="pt">当選のハードルが上がる</b>定数が減ると、当選に必要な票が増える。新しく立候補する人が、議会に入りにくくなる。</li>
              <li><b class="pt">減らすと戻しにくい</b>一度減らすと、元に戻すのは難しい。</li>
            </ul>
          </section>
          <section class="stance">
            <h3>減らす<span>（14人や12人など）という意見</span></h3>
            <ul>
              <li><b class="pt">人口に合わせる</b>16人に決めたころから、人口は約2割減った（2012年3月末17,818人→2026年10月14,313人）。2008年に議会が19人に減らしたときは「町民千人に対し議員1人」が理由の一つだった。この考え方を今の人口に当てはめると14人になる。さらに2029年には、16人に決めたころより約25%減る見込みで、16人の25%減は12人になる。</li>
              <li><b class="pt">町民が選べる選挙に</b>前回の町議選は16の議席に17人が立候補し、落選は1人だけ。今は欠員1の15人で、新たな立候補者がいなければ定数に届かない。</li>
              <li><b class="pt">同じ面積の町では12人</b>面積が同じくらい（180〜220km²）の全国の町では、定数の真ん中は12人。県内でも、湯梨浜町と岩美町が12人で議会を運営している。</li>
              <li><b class="pt">自ら見直す姿勢を示す</b>住民サービスが見直される中で、議会も自らの形を見直す姿勢を示すべきだ。</li>
            </ul>
          </section>
        </div>
        <h3>データで見る</h3>
        <HBar
          title="議員1人あたりの町民の数"
          caption="14人にすると、2033年の1人あたりの町民は、いまの16人とほぼ同じになります。"
          unit="人"
          items={[
            { label: '2010年', sub: '16人に決めたころ', value: 1093, display: '約1,090' },
            { label: '2025年', sub: '16人', value: 873, display: '約870' },
            { label: '2033年', sub: '16人のまま', value: 763, display: '約760' },
            { label: '2033年', sub: '14人にしたら', value: 872, display: '約870', hi: true },
            { label: '2033年', sub: '12人にしたら', value: 1017, display: '約1,020' },
          ]}
          note="人口は2010年が国勢調査、2025年・2033年は国立社会保障・人口問題研究所の推計（2023年推計）。人口を定数で割って計算。"
        />
        <p class="note">県内・全国の町と比べるグラフは、<a href="#hikaku">「一言で言うと」の中</a>にあります。出典：全国町村議会議長会『町村議会議員の議員報酬等のあり方 最終報告』（2019年）、同「第71回町村議会実態調査」（2025年7月1日現在）、国勢調査、国立社会保障・人口問題研究所の将来推計人口（2023年推計）、各町の議員定数条例、だいせん議会だより第13号（2008年8月）。</p>
      </div>
    </details>

    <details class="fold">
      <summary>主な論点</summary>
      <div class="body">
        <p class="note">賛成側にも反対側にも、同じように確かめます。</p>
        <ol class="kensho">
          <li>
            <b>① 減らせば、選挙は活発になる？</b>
            町によって結果は分かれています。県内では、若桜町や江府町のように、無投票や定数割れのあとに定数を減らし、次の町議選が選挙になった町があります。一方で、北栄町（15→13人）と伯耆町（14→13人）は、減らしたあとの2025年の町議選が無投票でした。人数だけで決まるものではなく、立候補する人がいるかどうかが大きいと言えます。
            <span class="src">出典：選挙ドットコム、各町の選挙結果、各町の議員定数条例</span>
            <figure class="chart">
              <figcaption class="chart-title">大山町の町議選（定数16人になってから）</figcaption>
              <table class="cmp">
                <thead><tr><th>年</th><th>立候補</th><th>落選</th><th>投票率</th></tr></thead>
                <tbody>
                  <tr><th>2013年</th><td>17人</td><td>1人</td><td>79.3%</td></tr>
                  <tr><th>2017年</th><td>19人</td><td>3人</td><td>75.8%</td></tr>
                  <tr><th>2021年</th><td>20人</td><td>4人</td><td>68.8%</td></tr>
                  <tr><th>2025年</th><td>17人</td><td>1人</td><td>70.5%</td></tr>
                </tbody>
              </table>
              <p class="chart-note">大山町の町議選は町長選と同じ日に行われる（2021年は町長が無投票）。出典：選挙ドットコム</p>
            </figure>
          </li>
          <li>
            <b>② お金はどれだけ変わる？</b>
            議員を2人減らすと、報酬と期末手当で年約760万円、4年の任期で約3,000万円です。町の予算全体から見れば大きな割合ではない、という見方があります。一方で、町民にサービスの見直しをお願いする中、議会も自らの形を見直すことに意味がある、という見方もあります。
            <span class="src">出典：大山町議会議員の議員報酬及び費用弁償等に関する条例から計算</span>
          </li>
          <li>
            <b>③ 地域の声は届かなくなる？</b>
            大山町の町議選は、2008年に議会が旧町ごとの選挙区をなくしてから、町全体で1つの選挙区です。今の16人でも、地区ごとの代表は保証されていません。減らせば議員のいない地区が増えるおそれがある、という見方があります。一方で、もともと町全体から選ぶ仕組みなので、大事なのは人数よりも、町全体の声を聞いて動けるかどうかだ、という見方もあります。
            <span class="src">出典：大山町議会議員の定数を定める条例の附則</span>
          </li>
          <li>
            <b>④ 直接請求で、条例は通る？</b>
            全国では、議員定数を減らす直接請求が、請求どおり可決された例は多くありません（総務省の地方自治月報で、2016年4月から2025年3月までの14件に原案どおりの可決は見当たりません）。ただ、福島県川俣町では2015年、町民の直接請求で16人から12人への条例案が可決されました。また、可決されなくても、署名が集まって請求が成立すれば、議会は必ず条例案を審議し、その結果は公表されます。
            <span class="src">出典：総務省『地方自治月報』、地方自治法第74条</span>
          </li>
        </ol>
      </div>
    </details>

    <section class="iken" aria-label="私はこう考える">
      <div class="obi"><b>私はこう考える</b><span>ここからは小谷英介の意見です</span></div>
      <div class="sign top"><img class="face" src={u('/kodani.jpg')} alt="" width="44" height="44" /><span>{SITE.operator}（{SITE.operatorTitle}、直接請求の代表者）</span></div>
      <details class="ikenfold">
        <summary>議員定数14人を提案する理由</summary>
        <div class="ikenbody">
        <p>私は、大山町議会の議員定数を16人から14人に減らすよう、住民による直接請求という仕組みを使って提案しています。</p>
        <p>私が議員だったときにも、議会改革特別委員会で議員定数について話し合いました。議員へのアンケートでは約半数が「削減すべき」と答えていましたが、最後の採決では削減に賛成する人が減り、見直しには至りませんでした。自分たちの人数を自分たちで減らす案は、議会の中からは、なかなか決めにくいということもあるかもしれませんし、議員の中には「もっと町民の意見を聞かないと」と慎重な意見もありました。いま私は議会を離れ、一人の町民になりました。今度は町民の側から、この提案をしようと決めました。</p>
        <p>議員の定数に正解はありません。そのことを大前提としたうえで、人口が減り、テクノロジーが暮らしや仕事のあり方を変えつつあるいま、16人がこの先もずっと必要だとは、私は考えていません。</p>
        <p>実際、いまの議会は、議員1人が任期途中で辞職したあと、15人で運営されています。</p>
        <p>また、2008年に議会が定数を21人から19人に減らしたとき、特別委員会では「町民千人に対し議員1人」が理由の一つに挙げられました。この考え方を今の人口に当てはめると、14人になります。</p>
        <p>今後のなり手の確保の問題もあります。大山町議会は、これまで比較的多くの人が立候補してきました。しかし前回の町議選では、16の議席に17人が立ち、落選したのは1人だけでした。無投票にこそなりませんでしたが、その足音は近づいています。新しく立候補する人が出なければ、いまの15人が全員そろって立候補しても、定数の16人には届きません。定員割れです。</p>
        <p>もう一つ大切にしたいのは、住民の納得感です。町の財政は厳しさを増し、議会が認めている予算には、町民にサービスの見直しをお願いするものも含まれています。そうしたお願いをしているいまこそ、議会も自らの形を見直す。その姿勢が、町の決定への共感と納得につながると考えています。</p>
        <p>ただ、減らせば減らすほどいい、というものでもありません。実は私も当初は、4人減らして12人にする案を考えていました。けれども調べを進めるうちに、減らしすぎることの弊害も見えてきました。いちばん大きいのは、新しく手を挙げる人のハードルが上がり、議会の新陳代謝が止まってしまうことです。考えた末に、14人を提案することにしました。</p>
        <p>この提案がなくても、いずれ議会の中で定数の見直しが話し合われることはあると思います。それでも、議員として内側にいた経験から言えば、町民の側からの後押しがあってこそ、議会も一歩を踏み出しやすくなるはずです。</p>
        <p>定数を減らすことに賛成の方は、ぜひ署名にご協力ください。町民の意思として、一緒にこの提案を議会に届けましょう。</p>
        </div>
      </details>
    </section>

