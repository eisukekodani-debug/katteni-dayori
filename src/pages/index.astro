---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';

// 報道（新しいまとまりを上に足す）。リンクは期限切れや会員限定になるため載せない
// 見出しは改行してよい区切りごとに分ける。title がないものは memo を表示する
const HODO = [
  {
    label: '署名の提出',
    items: [
      { media: 'NHK', date: '11月18日', memo: ['鳥取放送局の夕方の番組', '「いろ★ドリ」で放送'] },
      { media: '日本海新聞', date: '11月19日', title: ['議員定数削減を', '求める署名提出'] },
      { media: '山陰中央新報', date: '11月19日', title: ['町議定数2減求め', '署名提出'] },
      { media: '読売新聞', date: '11月19日', title: ['大山町議定数減　', '950人分署名提出'] },
      { media: '毎日新聞', date: '11月19日', title: ['議会定数減求め　', '署名950筆を提出'] },
    ],
  },
  {
    label: '署名活動の開始',
    items: [
      { media: '山陰中央新報', date: '10月21日', title: ['議員定数削減', '直接請求へ　', '大山町民有志が', '署名活動'] },
      { media: '読売新聞', date: '10月21日', title: ['大山町議の定数　', '削減へ', '署名活動'] },
      { media: 'NHK', date: '10月20日', title: ['鳥取 ', '大山町住民有志が', '議員定数削減を', '求めて', '署名開始'] },
      { media: '日本海新聞', date: '10月20日', title: ['大山町民有志が', '議員定数2減', '直接請求で', '署名活動'] },
    ],
  },
];
// 媒体名の並び（知られている順）
const MEDIA = ['NHK', '読売新聞', '毎日新聞', '山陰中央新報', '日本海新聞'];
---
<Base hideSubtitle>
  <div class="wrap">
    <section class="hero hokoku">
      <p class="hk-tag">ご報告<span class="hk-d">11月18日・19日</span></p>
      <h2 class="hk-h"><span class="nw">980人の署名を、</span><span class="nw">選挙管理委員会に</span><span class="nw">提出しました</span></h2>
      <div class="hk-nums" aria-label="必要な数248人に対して、980人の署名が集まりました">
        <p class="row"><span><span class="cap">必要な数</span><span class="n s">248<small>人</small></span></span><span class="arrow" aria-hidden="true">→</span><span><span class="cap">集まった署名</span><span class="n">980<small>人</small></span></span></p>
        <p class="bai">必要な数の、約4倍</p>
      </div>
      <p>大山町議会の議員定数を<b>16人から14人</b>にする条例改正を求めて、10月17日から1か月間、署名を集めました。</p>
      <p>署名してくださった皆さん、まわりに声をかけてくださった協力者の皆さん、本当にありがとうございました。</p>
      <p class="note">有効な署名の数は、これから選挙管理委員会の審査で決まります。</p>
      <p class="herobtns"><a class="pbtn" href="#nagare">これからの流れ</a><a class="sbtn" href="#riyu">なぜ14人？</a></p>
    </section>

    <section class="hodo" aria-labelledby="hodo-h">
      <h2 class="hodo-h" id="hodo-h">署名の提出が、テレビと新聞で報じられました</h2>
      <p class="hodo-media">{MEDIA.map((m) => <span>{m}</span>)}</p>
      <p class="hodo-teisei"><b>報道では「950」となっています。</b>これは代表者の{SITE.operator}の数え間違いで、署名簿1冊分を数え漏らしたまま、950とお伝えしてしまいました。翌日、役場で確認していただき、正しくは980人でした。混乱させてしまい、申し訳ありません。</p>
      <details class="hodo-more">
        <summary>報道の見出しと日付</summary>
        {HODO.map((g) => (
          <>
            <p class="hodo-g">{g.label}</p>
            <ul class="hodo-list">
              {g.items.map((h) => (
                <li><span class="hodo-m">{h.media}<span class="hodo-d">{h.date}</span></span>{h.title
                  ? <span class="hodo-t">「{h.title.map((s) => <span class="nw">{s}</span>)}」</span>
                  : <span class="hodo-t">{h.memo!.map((s) => <span class="nw">{s}</span>)}</span>}</li>
              ))}
            </ul>
          </>
        ))}
      </details>
    </section>

    <h2 class="sec" id="nagare">これからの流れ</h2>
    <ol class="nagare">
      <li class="done"><span class="who">代表者</span><b>町に申請し、町が告示する</b><span class="when">10月13日・16日</span></li>
      <li class="done"><span class="who">町民</span><b>署名を集める</b><span class="when"><span class="nw">10月17日（土）</span>〜<span class="nw">11月16日（月）</span>。980人分が集まりました</span></li>
      <li class="done"><span class="who">代表者</span><b>署名簿を提出する</b><span class="when">11月18日（水）・19日（木）、選挙管理委員会へ</span></li>
      <li class="now"><b class="nowtag">いま、ここ</b><span class="who">選挙管理委員会</span><b>署名の審査と縦覧</b><span class="when">11月下旬〜12月中旬</span><span class="hl">20日以内に署名を審査して、有効な数を発表します。そのあと7日間、署名簿を誰でも見られるようにします（縦覧）。</span></li>
      <li><span class="who">代表者</span><b>町長に正式に請求する</b><span class="when">12月中旬〜下旬ごろ。署名簿が戻ってから5日以内</span></li>
      <li class="gikai"><span class="who">議会</span><b>条例案を審議し、採決する</b><span class="when">12月下旬〜1月ごろ。町長は請求から20日以内に議会を開き、意見を付けて条例案を出します。代表者が議会で意見を述べたうえで、議会が賛否を決めます</span></li>
    </ol>
    <p class="note">審査から先の日付は予定です。くわしい手続きは<a href={u('/teisu/')}>記事</a>の「直接請求って何？」に載せています。</p>

    <section id="riyu">
      <h2 class="sec">なぜ14人？</h2>
      <figure class="chart">
        <figcaption class="chart-title">人口は約2割減ったのに、定数は16人のまま</figcaption>
        <div class="cols4">
          <div class="c"><span class="v">17,818<small>人</small></span><span class="bar" style="height:120px"></span></div>
          <div class="c"><span class="v">16,889<small>人</small></span><span class="bar" style="height:114px"></span></div>
          <div class="c"><span class="v">15,822<small>人</small></span><span class="bar" style="height:107px"></span></div>
          <div class="c hi"><span class="v">14,313<small>人</small></span><span class="bar" style="height:96px"></span></div>
          <span class="l">2012年<br />（16人に<br />決めた頃）</span>
          <span class="l">2016年</span>
          <span class="l">2021年</span>
          <span class="l">2026年<br />（いま）</span>
        </div>
        <p class="chart-note">大山町の住民基本台帳の人口（2012〜2021年は3月末、2026年は10月1日）</p>
      </figure>
      <ol class="riyu">
        <li><b>人口に合わせると、14人</b><span>2008年に議会が定数を減らしたとき、「町民千人に議員1人」が理由の一つでした。今の人口14,313人に当てはめると、14人です。</span></li>
        <li><b>次の選挙は、定数割れのおそれ</b><span>昨年の町議選は、16の議席に17人が立候補。今の議員は15人で、全員が再び立候補しても、それだけでは定数に届きません。</span></li>
        <li><b>議会も、自らの形を見直す</b><span>住民サービスの見直しが進む中、議会にも自らの形を見直す姿勢を見せてほしいと考えます。</span></li>
      </ol>
      <a class="sbtn" href={u('/teisu/')}>くわしい記事（県内・全国との比較、維持すべきという意見も）→</a>
    </section>

    <section class="omoi" aria-labelledby="omoi-h">
      <p class="omoi-tag">請求代表者の思い</p>
      <h2 class="omoi-h" id="omoi-h">選挙のない町には、したくない。</h2>
      <div class="omoi-row">
        <img src={u('/kodani-inekari.jpg')} alt="稲刈りをする小谷英介" width="480" height="592" loading="lazy" />
        <div>
          <p>私がいちばん恐れているのは、次の町議選が無投票になることです。「こんな町にしたい」と一票を入れることは、町を自分たちでつくる第一歩だと考えています。</p>
          <p class="omoi-name">小谷英介（請求代表者）</p>
        </div>
      </div>
      <a class="pbtn" href={u('/about/')}>続きを読む（小谷えいすけ 町民レポート）</a>
    </section>

    <h2 class="sec" id="nagare">署名から議会までの流れ</h2>
    <ol class="nagare">
      <li class="done"><span class="who">代表者</span><b>町に申請し、町が告示する</b><span class="when">10月13日・16日</span></li>
      <li class="now"><b class="nowtag">いま、ここ</b><span class="who">町民</span><b>署名を集める</b><span class="when"><span class="nw">10月17日（土）</span>〜<span class="nw">11月16日（月）</span></span><span class="hl">有権者の50分の1以上（248人以上）が必要です。</span></li>
      <li><span class="who">選挙管理委員会</span><b>署名の審査と縦覧</b><span class="when">11月下旬〜12月中旬</span></li>
      <li><span class="who">代表者</span><b>町に正式に請求する</b><span class="when">12月下旬ごろ</span></li>
      <li class="gikai"><span class="who">議会</span><b>条例案を審議し、採決する</b><span class="when">1月ごろ。代表者が議会で意見を述べたうえで、議会が賛否を決めます</span></li>
    </ol>
    <p class="note">審査から先の日付は予定です。くわしい手続きは<a href={u('/teisu/')}>記事</a>の「直接請求って何？」に載せています。</p>

    <section class="ai-top">
      <p class="ai-top-tag">住民の声</p>
      <h2>議会について、あなたの声を</h2>
      <p>議会に期待することを、AIが聞き手になって集めています（AIインタビュー）。賛否は問いません。ニックネームで答えられ、最後にあなたの意見を3行の「意見カード」にまとめます。</p>
      <p class="btns"><a class="pbtn" href={u('/interview/')}>インタビューに答える</a> <a class="sbtn" href={u('/ai-interview/#koe')}>寄せられた声を見る</a></p>
      <p class="note">インタビューは署名ではありません。署名は、紙の署名簿でだけ行います。</p>
    </section>

    <section class="kairan">
      <h2>最新情報は、公式LINEで</h2>
      <p>審査の結果や、議会での審議の日程と結果を、節目ごとにお知らせします。誰が登録したかは、運営者にもわからない仕組みです。</p>
      <a class="linebtn" href={SITE.lineUrl} data-line="ページ下">LINEで友だち追加する</a>
      <p style="margin:10px 0 0"><a href={u('/line/')}>QRコードとお知らせの内容</a></p>
    </section>

  </div>
</Base>

<style>
  .hokoku .hk-tag { margin: 0 0 6px; text-align: center; font: 700 15px/1.6 var(--gothic); letter-spacing: .1em; }
  .hokoku .hk-tag .hk-d { margin-left: 10px; font-weight: 400; letter-spacing: 0; color: var(--usuzumi); }
  .hokoku .hk-h { font-family: var(--mincho); font-weight: 800; font-size: min(calc(var(--base) * 1.55), 7vw); line-height: 1.5; text-align: center; margin: 0 0 16px; }
  .hokoku .hk-h .nw { display: inline-block; white-space: nowrap; }
  @media (min-width: 768px) { .hokoku .hk-h { font-size: calc(var(--base) * 1.8); } }
  .hk-nums { background: var(--kiri); border-top: 3px solid var(--sumi); padding: 14px 10px 12px; margin: 0 0 16px; text-align: center; }
  .hk-nums .row { display: flex; align-items: flex-end; justify-content: center; gap: 14px; margin: 0; font-family: var(--mincho); font-weight: 800; }
  .hk-nums .cap { display: block; font: 700 14px/1.3 var(--gothic); color: var(--usuzumi); margin-bottom: 4px; }
  .hk-nums .n { display: block; font-size: 72px; line-height: 1; }
  .hk-nums .n.s { font-size: 40px; color: var(--usuzumi); }
  .hk-nums .n small { font-size: 24px; margin-left: 2px; }
  .hk-nums .n.s small { font-size: 18px; }
  .hk-nums .arrow { font-size: 28px; color: var(--usuzumi); padding-bottom: 6px; }
  .hk-nums .bai { margin: 10px 0 0; font-family: var(--mincho); font-weight: 800; font-size: calc(var(--base) * 1.15); }
  @media (max-width: 420px) { .hk-nums .n { font-size: 60px; } .hk-nums .n.s { font-size: 34px; } }
  .hodo-media span:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (min-width: 600px) { .hodo-media span:last-child:nth-child(odd) { grid-column: auto; } }
  .hodo-g { margin: 10px 0 0; font: 700 14px/1.6 var(--gothic); color: var(--usuzumi); }
  .hodo-teisei { text-align: left; font-size: 16px; line-height: 1.75; background: var(--kiri); padding: 10px 12px; margin: 0 0 12px; }
  .hodo-teisei b { display: block; }
  .omoi { background: var(--men); border: 2px solid var(--sumi); padding: 18px 16px 20px; margin: 32px 0; }
  .omoi-tag { margin: 0; font-size: 15px; font-weight: 700; color: var(--usuzumi); letter-spacing: .08em; }
  .omoi-h { font-family: var(--mincho); font-weight: 800; font-size: calc(var(--base) * 1.45); line-height: 1.4; margin: 4px 0 14px; }
  .omoi-row { display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 16px; }
  .omoi-row img { width: 100%; max-width: 260px; height: auto; display: block; }
  @media (min-width: 600px) { .omoi-row { grid-template-columns: 200px 1fr; gap: 18px; } .omoi-row img { max-width: 200px; } }
  .omoi-row p { margin: 0 0 8px; line-height: 1.8; }
  .omoi-name { font-size: 15px; color: var(--usuzumi); }
</style>
