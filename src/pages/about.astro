---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { SITE } from '../config/site';

// 略歴は町民レポート（2026年11月）とそろえる。大学名・会社名・受賞歴は入れない（本人方針）
const keireki = [
  ['1982年', '旧中山町下甲に生まれる'],
  ['2006年', '東京で会社勤めを始める'],
  ['2014年', '大山町にUターン。地域おこし協力隊の1期生に'],
  ['2016年', 'まちづくり会社を設立'],
  ['2021年', '大山町議会議員（2024年まで）'],
  ['2025年', '大山町長選挙に立候補し、落選'],
  ['現在', '公職を離れ、農作業や地域の仕事に携わる'],
];
---
<Base title="小谷えいすけ 町民レポート（請求代表者の思い）" description="議員定数を16人から14人に減らす署名を集めている、請求代表者・小谷英介の思い。いちばん恐れているのは、次の町議選が無投票になること。">
  <article class="wrap report">
    <div class="futasuji" style="margin-top:28px"></div>
    <p class="kicker">請求代表者の思い</p>
    <h1 class="title">小谷えいすけ 町民レポート</h1>

    <h2 class="report-hl">選挙のない町には、したくない。</h2>
    <p class="lead"><b>大山町議会の議員の数を16人から14人にする署名を集めています。私がいちばん恐れているのは、次の町議選が無投票になることです。</b></p>

    <figure class="report-photo">
      <img src={u('/kodani-inekari.jpg')} alt="稲刈りをする小谷英介" width="480" height="592" loading="lazy" />
      <figcaption>小谷英介（こだに えいすけ）　議員定数削減の署名 請求代表者</figcaption>
    </figure>

    <h2 class="sec">次の選挙は、定数割れのおそれ</h2>
    <p>町の人口は、この14年で約2割減りました（平成24年の17,818人から、今年の14,313人に）。昨年の町議選は、定数16人に対して候補者17人。今の議員は15人で、全員が再び立候補しても、それだけでは定数に届きません。次は出馬しない意向の方もいると聞きます。<mark>無投票になる可能性は、これまでより高くなっていると私は考えています。</mark></p>

    <h2 class="sec">なぜ14人なのか</h2>
    <p>町議会は平成20年、<mark>「町民千人に対し議員1人」</mark>という基準で定数を減らしました（議会だより第13号）。今の人口14,313人に当てはめれば、14人が妥当だと考えます。</p>

    <h2 class="sec">投票を通じて、町のことを考える</h2>
    <p>「こんな町にしたい」と一票を入れることは、町を自分たちでつくる第一歩です。選ばれる側も、次の選挙があるからこそ、緊張感を持って取り組みます。<b>だから私は、無投票だけは絶対に避けるべきだと考えています。</b></p>

    <h2 class="sec">議会の中では、決めきれなかった</h2>
    <p>2023年、定数を話し合う議会の特別委員会で、私は「減らす」に手を挙げました。事前のアンケートでは<mark>議員の約半数が「減らした方がいい」と答えていました</mark>が、採決は4対10で現状維持。維持を選んだ議員からは「もっと町民の声を聞くべきだ」という意見が出ました。</p>
    <p>いま一人の町民として声を集め、<mark>テレビ中継の入る開かれた議会の場で、もう一度議論してほしい</mark>と思っています。</p>

    <h2 class="sec">14人で、何が変わるのか</h2>
    <p>正直に言えば、劇的には変わりません。それでも選挙になる見込みは高まり、町の行く先を一票で選ぶ機会が守られます。役場や議会に任せておけば済む時代は終わりました。これからは、<mark>町のことを自分ごととして考える人を増やしたい。</mark>この署名も、そのきっかけの一つにしたいのです。</p>

    <h2 class="sec">よく聞かれる疑問</h2>
    <dl class="qa">
      <dt>議員が減ると、少ない声が届かなくなるのでは？</dt>
      <dd>人数よりも、議員一人ひとりが地域に足を運び、話を聞くかどうかで決まると考えます。</dd>
      <dt>問題は、議員の数だけではないのでは？</dt>
      <dd>その通りです。議会のあり方への思いを「AIインタビュー」で集めています。<a href={u('/ai-interview/')}>インタビューに答える</a></dd>
    </dl>

    <h2 class="sec">略歴</h2>
    <dl class="keireki">
      {keireki.map(([y, t]) => (<><dt>{y}</dt><dd>{t}</dd></>))}
    </dl>
    <p class="note" style="margin-top:8px">空き家だったお家を借りて、大山口で暮らしています。小学3年生の息子の父です。</p>

    <div class="report-pdf">
      <a class="btn" href={u('/kodani-report-202611.pdf')}>町民レポートを印刷する（PDF・A4片面）</a>
      <p class="note">白黒で印刷できます。まわりの方に渡していただけるとうれしいです。</p>
    </div>

    <h2 class="sec">請求代表者のSNS</h2>
    <div class="sns">
      <a href={SITE.instagramUrl}>Instagram</a>
      <a href={SITE.facebookUrl}>Facebook</a>
    </div>
    <p style="margin-top:14px">ご連絡は、<a href={u('/contact/')}>お問い合わせ</a>からどうぞ。</p>
  </article>
</Base>

<style>
  .report .kicker { margin: 18px 0 2px; font-size: 15px; font-weight: 700; color: var(--usuzumi); letter-spacing: .08em; }
  .report .title { margin-top: 0; }
  .report-hl { font-family: var(--mincho); font-weight: 800; font-size: calc(var(--base) * 1.7); line-height: 1.35; margin: 18px 0 10px; }
  .report mark { background: #FFF2A8; color: inherit; padding: .05em 0; }
  .report-photo { margin: 22px 0 6px; }
  .report-photo img { display: block; width: 100%; max-width: 360px; height: auto; }
  .report-photo figcaption { margin-top: 8px; font-size: 15px; color: var(--usuzumi); }
  .report .qa { margin: 0; }
  .report .qa dt { font-weight: 700; margin-top: 14px; padding-left: 1.6em; text-indent: -1.6em; }
  .report .qa dt::before { content: "問　"; font-family: var(--mincho); }
  .report .qa dd { margin: 6px 0 0; padding-left: 1.6em; text-indent: -1.6em; line-height: 1.8; }
  .report .qa dd::before { content: "答　"; font-family: var(--mincho); font-weight: 800; }
  .report .qa dd a { margin-left: .4em; }
  .report-pdf { margin: 28px 0 8px; padding: 18px; border: 1.5px solid var(--sumi); }
  .report-pdf .btn { display: block; text-align: center; padding: 14px; background: var(--sumi); color: #fff; font-weight: 700; text-decoration: none; border-radius: 6px; }
  .report-pdf .note { margin: 10px 0 0; }
</style>
