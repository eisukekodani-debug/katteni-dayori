---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
---
<Base title="AIインタビュー" description="署名とは別に、私たち住民の声を集めて町や議会に届ける仕組みとして、試験的に始めたAIインタビューです。答えた方の「意見カード」を紹介しています。">
  <article class="wrap">
    <div class="futasuji" style="margin-top:28px"></div>
    <h1 class="title">AIインタビュー</h1>
    <p>署名とは別に、私たち住民の声を集めて町や議会に届ける仕組みとして、「AIインタビュー」を試験的に始めています。議会への要望などを、賛否を問わず、AIが聞き手となって、文字のやりとりで質問します。AIが賛否を勧めることはなく、名前を出さずに答えられます。あなたの話に合わせて質問が進み、最後に、あなたの意見を3行の「意見カード」にまとめます。</p>
    <div class="koshin">
      <span class="koshin-tag">更新</span>
      <div>
        <p><b>10月22日</b>　議員の報酬についての質問を加えました。「定数だけでなく、報酬も見直すべきでは」というご意見をいただき、なり手の話とあわせて、報酬をどう考えるかも聞くようにしました。</p>
        <p class="hoshu">いまの大山町議会の議員報酬は<b>月23万5千円</b>です。6月と12月の期末手当を合わせると、議員1人あたり<b>年約379万円</b>になります。</p>
        <p class="hoshu-src">議長は月32万3千円、副議長は月24万9千円、委員長は月24万円（2024年4月改正）。期末手当は2025年度の支給率で計算。出典：大山町議会ホームページ「議員の報酬」</p>
      </div>
    </div>
    <div class="ai-chui">
      <b>これは署名ではありません。</b>
      署名ができるのは、紙の署名簿だけです。このインタビューは、署名とは別に、私たち住民の声を集めて町や議会に届けるための取り組みです。
    </div>
    <a class="pbtn" href={u('/interview/')}>インタビューに答える</a>

    <h2 class="sec">答えると、こんなカードができます</h2>
    <figure class="mihon">
      <figcaption><b>カードの見本</b>　「定数太郎」さんは架空の方です。カードを押すと大きく表示されます。</figcaption>
      <div id="mihon-card"></div>
    </figure>

    <section class="koe" id="koe">
      <h2>これまでに寄せられた声<span class="koe-n" id="koe-n"></span></h2>
      <p>インタビューに答え、公開に同意してくださった方の「意見カード」です。運営者が確かめてから載せています。</p>
      <div id="cards" class="ai-cards"><p class="note">読み込んでいます…</p></div>
      <p class="zoom-hint">カードを押すと、大きく表示されます。</p>
      <a class="pbtn" href={u('/interview/')}>あなたの声も聞かせてください</a>
    </section>
    <dialog class="zoom" id="zoom" aria-label="意見カードの拡大表示">
      <button type="button" class="zoom-close" id="zoom-close">閉じる ✕</button>
      <img id="zoom-img" alt="" />
    </dialog>
    <p class="note" style="margin-top:20px"><a href={u('/interview/privacy/')}>回答の取り扱いについて</a></p>
    <p class="note" style="margin-top:20px">このAIインタビューは、チームみらいが行っているAIインタビューの取り組みを参考にさせていただき、つくりました。なお、運営者の小谷英介はチームみらいの党員ではなく、この取り組みは特定の政党とは関係がありません。</p>
  </article>
</Base>

<style is:global>
  .ai-chui { background: var(--kairan); padding: 14px 16px; margin: 16px 0 20px; }
  .ai-chui b { display: block; }
  .koe { background: var(--kairan); border-top: 4px solid var(--sumi); padding: 20px 16px 22px; margin: 28px 0 32px; }
  .koe h2 { font-family: var(--mincho); font-size: calc(var(--base) * 1.45); line-height: 1.4; margin: 0 0 8px; }
  .koe h2 .koe-n { display: block; width: fit-content; margin: 6px 0 0; font: 700 15px/1.7 var(--gothic); background: var(--sumi); color: #fff; padding: 0 10px; border-radius: 2px; }
  .koe h2 .koe-n:empty { display: none; }
  .koe > p { margin: 0 0 14px; }
  .koe .ai-cards { margin-bottom: 18px; }
  .ai-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .mihon { margin: 8px 0 20px; padding: 12px; border: 2px dashed var(--kei); }
  .mihon figcaption { font-size: 15px; margin-bottom: 8px; }
  .mihon #mihon-card img { display: block; width: 100%; max-width: 320px; height: auto; border: 1px solid var(--kei); }
  .ai-cards img { display: block; width: 100%; height: auto; border: 1px solid var(--kei); }
  .ai-cards img, .mihon #mihon-card img { cursor: zoom-in; }
  .zoom-hint { font-size: 14px; color: var(--usuzumi); margin: 6px 0 0; }
  .zoom { border: none; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; }
  .zoom::backdrop { background: rgba(0, 0, 0, .82); }
  .zoom[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
  .zoom img { display: block; max-width: min(94vw, 760px); max-height: 82vh; width: auto; height: auto; background: #fff; }
  .zoom-close { font: 700 16px/1 var(--gothic); background: #fff; color: var(--sumi); border: none; border-radius: 4px; padding: 12px 18px; min-height: 44px; cursor: pointer; }
</style>

<script is:inline src="/interview/card.js"></script>
<script is:inline>
(function () {
  var API_URL = 'https://script.google.com/macros/s/AKfycbyMaSq32OWSUC6uIiFBk8GZ2hnu4IiQbWJdZDxVHI2HRk_Ugtr2jZdMkEAZrzt9oRKr7Q/exec';
  var box = document.getElementById('cards');
  function note(text) {
    box.textContent = '';
    var p = document.createElement('p'); p.className = 'note'; p.textContent = text; box.appendChild(p);
  }
  // カードを押すと拡大表示する
  var zoom = document.getElementById('zoom'), zimg = document.getElementById('zoom-img');
  function openZoom(img) {
    zimg.src = img.src; zimg.alt = img.alt;
    if (zoom.showModal) zoom.showModal(); else window.open(img.src);
  }
  function makeZoomable(img) {
    img.tabIndex = 0; img.setAttribute('role', 'button');
    img.addEventListener('click', function () { openZoom(img); });
    img.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openZoom(img); } });
  }
  document.getElementById('zoom-close').addEventListener('click', function () { zoom.close(); });
  zoom.addEventListener('click', function (e) { if (e.target === zoom) zoom.close(); });
  // 見本のカード（架空の方の例。実際の意見とは分けて表示する）
  var mihon = document.getElementById('mihon-card');
  drawCard(['議会で何が話し合われているのか、もっと知りたい', '議員と気軽に話せる場が、地域にあるといい', '定数は、町の将来の姿とあわせて考えてほしい'], '定数太郎', 'm').then(function (url) {
    var img = new Image(); img.src = url; img.alt = '見本：定数太郎さんの意見カード'; makeZoomable(img); mihon.appendChild(img);
  });
  fetch(API_URL + '?action=cards').then(function (r) { return r.json(); }).then(function (d) {
    var cards = (d && d.cards) || [];
    if (!cards.length) { note('まだ載っている意見カードはありません。'); return; }
    document.getElementById('koe-n').textContent = cards.length + '件の声が届いています';
    box.textContent = '';
    // 1枚ずつ順番に描く
    cards.reduce(function (p, c) {
      return p.then(function () {
        return drawCard(c.lines, c.nick, c.sex).then(function (url) {
          var img = new Image();
          img.src = url; img.loading = 'lazy';
          img.alt = c.nick + 'の意見：' + c.lines.join('／');
          makeZoomable(img);
          box.appendChild(img);
        });
      });
    }, Promise.resolve());
  }).catch(function () {
    note('意見カードを読み込めませんでした。時間をおいて、もう一度開いてください。');
  });
})();
</script>
